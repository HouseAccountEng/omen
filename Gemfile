source 'https://rubygems.org'

# Specify your gem's dependencies in omen.gemspec.
gemspec

gem 'debug' # to break into a test that fails
gem 'minitest' # to run the suite
gem 'rubocop-rails-omakase', require: false # to lint in the house style
gem 'simplecov', require: false # to fail the suite where a line went untested
gem 'webmock' # to answer the Claude API in a test without reaching it

<h1><%= plural_name.humanize %></h1>

<%%= render 'form', <%= singular_name %>: @<%= singular_name %> %>

<ul>
  <%% @<%= plural_name %>.each do |<%= singular_name %>| %>
    <li>
      <%%= link_to <%= singular_name %>, <%= singular_name %> %>
      <%% if <%= singular_name %>.answering? %><em>answering</em><%% end %>
    </li>
  <%% end %>
</ul>
